# Flask
SECRET_KEY=your-secret-key-here
FLASK_DEBUG=True

# Database (MySQL)
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=temperature_monitoring_system

# Email Alerts
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Temperature Thresholds (fallback defaults)
DEFAULT_WARNING_TEMP=35.0
DEFAULT_CRITICAL_TEMP=45.0
