# Flask
SECRET_KEY=your-secret-key-here
FLASK_DEBUG=True

# Database (Supabase Postgres, via SQLAlchemy)
# Settings → Database → Connection string → URI (use the 6543 pooler)
DATABASE_URL=postgresql+psycopg2://user:password@host:6543/postgres?sslmode=require

# Email Alerts
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Temperature Thresholds (fallback defaults)
DEFAULT_WARNING_TEMP=35.0
DEFAULT_CRITICAL_TEMP=45.0
